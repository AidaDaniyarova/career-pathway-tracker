# Copy to backend/.env for local (non-docker) development. Never commit .env.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# DEBUG defaults to False. Set True only on your own machine.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Database: either a single connection URL (Neon) ...
# Get it with: neon connection-string --project-id <id> --pooled
DATABASE_URL=
# ... or individual settings (used when DATABASE_URL is empty)
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=5432

REDIS_URL=redis://localhost:6379
# Optional. Hugging Face fine-grained token with the "Make calls to Inference Providers"
# permission (https://huggingface.co/settings/tokens). HUGGINGFACE_API_KEY still works as an old name.
HF_TOKEN=